      </div>

      <div class="panel rounded-3xl p-3.5">
        <div class="flex items-center card rounded-2xl p-1.5 focus-within:border-pink-400">
          <input type="url" id="url-input" placeholder="Paste your link here" autocomplete="off" class="w-full bg-transparent px-3 py-2.5 text-sm text-slate-900 placeholder-slate-400 focus:outline-none">
          <button id="btn-paste" title="Paste" class="w-9 h-9 rounded-xl bg-white border border-slate-200 text-indigo-600 active:scale-95"><i class="fas fa-paste text-xs"></i></button>
          <button id="btn-clear" title="Clear" class="hidden w-9 h-9 ml-1 rounded-xl bg-white border border-slate-200 text-slate-500 active:scale-95"><i class="fas fa-times text-xs"></i></button>
        </div>
        <button id="btn-fetch" class="w-full mt-3 py-3.5 bg-gradient-to-r from-indigo-600 via-purple-600 to-pink-600 text-white font-extrabold text-sm tracking-widest rounded-2xl shadow-lg shadow-indigo-500/30 active:scale-[0.98]"><i class="fas fa-bolt text-xs"></i> DOWNLOAD</button>
      </div>

      <div id="toast" class="hidden card rounded-2xl p-3 border-l-4 text-xs flex items-center justify-between">
        <div class="flex items-center gap-2"><i id="toast-icon" class="fas fa-info-circle text-base"></i><span id="toast-text"></span></div>
