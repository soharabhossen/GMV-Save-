    <button onclick="switchTab('downloads')" id="nav-downloads" class="nav-btn flex-1 py-1.5 flex flex-col items-center text-slate-400"><i class="fas fa-download text-base"></i><span class="text-[10px]">Download</span></button>
  </div>
