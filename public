<script>
// এখানে আপনার Download API URL বসান
const API_URL = '';/api/download যেমন: 'https://your-server.com/api/download'
const AUTO_PASTE = true; // প্ল্যাটফর্ম বাছাই করলে ক্লিপবোর্ড থেকে লিংক অটো-পেস্ট

let selectedPlatform = null, currentMedia = null, toastTimer = null;
const $ = id => document.getElementById(id);
const PLATFORMS = ['facebook','tiktok','instagram','youtube'];

// ---------- safe storage ----------
function load(key, fallback) { try { return JSON.parse(localStorage.getItem(key)) ?? fallback; } catch (e) { return fallback; } }
function save(key, val) { try { localStorage.setItem(key, JSON.stringify(val)); } catch (e) {} }
function esc(s) { const d = document.createElement('div'); d.textContent = s ?? ''; return d.innerHTML; }

// ---------- init ----------
window.addEventListener('DOMContentLoaded', () => {
  const input = $('url-input');
  input.addEventListener('input', () => $('btn-clear').classList.toggle('hidden', !input.value.trim()));
  $('btn-clear').addEventListener('click', () => { input.value = ''; $('btn-clear').classList.add('hidden'); $('result').classList.add('hidden'); });
  $('btn-paste').addEventListener('click', pasteLink);
  $('btn-fetch').addEventListener('click', processMediaLink);
  loadSavedFilesUI();
});

async function pasteLink() {
  if (!selectedPlatform) return showToast('Select a platform first.', 'error');
  try {
    const t = (await navigator.clipboard.readText()).trim();
    if (t.startsWith('http')) { $('url-input').value = t; $('btn-clear').classList.remove('hidden'); showToast('Link pasted.', 'success'); }
    else showToast('No valid link in clipboard.', 'info');
  } catch (e) { showToast('Clipboard blocked. Paste the link manually.', 'info'); }
}

// ---------- platform ----------
function selectPlatform(p) {
  selectedPlatform = p;
  PLATFORMS.forEach(x => $('btn-' + x).classList.toggle('on', x === p));
  if (AUTO_PASTE && !$('url-input').value) pasteLinkSilent();
}
async function pasteLinkSilent() {
  try {
    const t = (await navigator.clipboard.readText()).trim();
    if (t.startsWith('http') && validateLinkPlatform(t, selectedPlatform)) {
      $('url-input').value = t;
      $('btn-clear').classList.remove('hidden');
    }
  } catch (e) {}
}
function validateLinkPlatform(url, p) {
  const u = url.toLowerCase();
  if (p === 'youtube') return u.includes('youtube.com') || u.includes('youtu.be');
  if (p === 'facebook') return u.includes('facebook.com') || u.includes('fb.watch') || u.includes('fb.com');
  if (p === 'tiktok') return u.includes('tiktok.com');
  if (p === 'instagram') return u.includes('instagram.com');
  return false;
}

// ---------- toast ----------
function showToast(msg, type = 'info') {
  const t = $('toast'), icon = $('toast-icon');
  $('toast-text').textContent = msg;
  t.classList.remove('hidden', 'border-emerald-500', 'border-red-500', 'border-indigo-500');
  const map = { success: ['border-emerald-500', 'fa-check-circle text-emerald-500'], error: ['border-red-500', 'fa-exclamation-circle text-red-500'], info: ['border-indigo-500', 'fa-info-circle text-indigo-500'] };
  t.classList.add(map[type][0]);
  icon.className = 'fas text-base ' + map[type][1];
  clearTimeout(toastTimer); toastTimer = setTimeout(hideToast, 4000);
}
function hideToast() { $('toast').classList.add('hidden'); }

// ---------- fetch media info ----------
async function processMediaLink() {
  const url = $('url-input').value.trim();
  if (!selectedPlatform) return showToast('Select a platform first.', 'error');
  if (!url) return showToast('Paste a media link first.', 'error');
  if (!validateLinkPlatform(url, selectedPlatform)) return showToast('This link is not a ' + selectedPlatform.toUpperCase() + ' link.', 'error');

  $('result').classList.add('hidden'); $('loading').classList.remove('hidden');
  const platform = selectedPlatform.toUpperCase();
  const ph = { youtube: 'FF0000', tiktok: 'FE2C55', instagram: 'd6249f', facebook: '1877F2' }[selectedPlatform];
  let title = '', img = '';

  try {
    if (selectedPlatform === 'youtube') {
      const m = url.match(/(?:youtu\.be\/|v=|shorts\/)([\w-]{6,})/);
      if (m) img = `https://img.youtube.com/vi/${m[1]}/hqdefault.jpg`;
    }
    if (selectedPlatform !== 'facebook') {
      const api = selectedPlatform === 'tiktok' ? 'https://www.tiktok.com/oembed?url=' : 'https://noembed.com/embed?url=';
      try {
        const d = await (await fetch(api + encodeURIComponent(url))).json();
        if (d.title) title = d.title;
        if (d.thumbnail_url) img = d.thumbnail_url;
      } catch (e) {}
    }
    title = title || platform + ' media';
    const fallback = `https://placehold.co/600x340/f1f5f9/${ph}?text=${platform}`;
    img = img || fallback;

    currentMedia = { url, platform, title, img, time: new Date().toLocaleString() };
    const pi = $('preview-img');
    pi.onerror = () => { pi.onerror = null; pi.src = fallback; };
    pi.src = img;
    $('preview-title').textContent = title;
    $('preview-badge').textContent = platform;
    $('loading').classList.add('hidden'); $('result').classList.remove('hidden');
    showToast('Media fetched.', 'success');
  } catch (e) {
    $('loading').classList.add('hidden');
    showToast('Could not fetch media. Try again.', 'error');
  }
}

// ---------- download ----------
async function triggerDownload(quality) {
  if (!currentMedia) return showToast('Fetch a media link first.', 'error');
  const api = API_URL.trim();
  if (!api) return showToast('Download API URL is not set in the code. Browsers cannot download from these sites directly.', 'error');

  const box = $('progress'), bar = $('dl-bar'), pct = $('dl-pct');
  box.classList.remove('hidden'); bar.style.width = '5%'; pct.textContent = '5%';
  $('dl-title').textContent = 'Preparing ' + quality + '…';
  try {
    const res = await fetch(api + (api.includes('?') ? '&' : '?') + 'url=' + encodeURIComponent(currentMedia.url) + '&quality=' + encodeURIComponent(quality));
    if (!res.ok) throw new Error('Server error ' + res.status);
    bar.style.width = '50%'; pct.textContent = '50%';
    const ct = res.headers.get('content-type') || '';
    let href;
    if (ct.includes('application/json')) {
      const d = await res.json();
      href = d.download_url || d.url;
      if (!href) throw new Error('No download link returned');
    } else {
      const blob = await res.blob();
      href = URL.createObjectURL(blob);
    }
    bar.style.width = '100%'; pct.textContent = '100%';
    const a = document.createElement('a');
    a.href = href; a.download = (currentMedia.title || 'media').replace(/[^\w\- ]+/g, '').slice(0, 60) + '.mp4';
    a.target = '_blank'; a.rel = 'noopener';
    document.body.appendChild(a); a.click(); a.remove();
    const files = load('gmv_saved', []);
    files.unshift({ title: currentMedia.title, platform: currentMedia.platform, img: currentMedia.img, quality, time: new Date().toLocaleString() });
    save('gmv_saved', files.slice(0, 50)); loadSavedFilesUI();
    $('dl-title').textContent = 'Download started';
    showToast('Download started (' + quality + ').', 'success');
  } catch (e) {
    $('dl-title').textContent = 'Download failed';
    showToast('Download failed: ' + e.message, 'error');
  }
  setTimeout(() => box.classList.add('hidden'), 3000);
}

// ---------- downloaded files ----------
function rowHTML(x, sub, extra) {
  return `<div class="panel rounded-2xl p-2.5 flex items-center gap-3">
    <img src="${esc(x.img)}" onerror="this.style.visibility='hidden'" class="w-16 h-11 rounded-lg object-cover bg-slate-100">
    <div class="flex-1 min-w-0"><div class="text-xs text-slate-900 truncate">${esc(x.title)}</div>
    <div class="text-[10px] text-slate-500">${esc(x.platform)} • ${esc(sub)}</div></div>${extra || ''}</div>`;
}
function loadSavedFilesUI() {
  const f = load('gmv_saved', []);
  $('saved-list').innerHTML = f.length
    ? f.map(x => rowHTML(x, x.quality + ' • ' + x.time, '<i class="fas fa-circle-check text-emerald-500 pr-2"></i>')).join('')
    : '<p class="text-center text-xs text-slate-500 py-8">No downloads yet.</p>';
}
function clearSaved() { save('gmv_saved', []); loadSavedFilesUI(); }

// ---------- tabs ----------
function switchTab(tab) {
  ['home','downloads'].forEach(t => {
    $('view-' + t).classList.toggle('hidden', t !== tab);
    $('nav-' + t).classList.toggle('active', t === tab);
    $('nav-' + t).classList.toggle('text-slate-400', t !== tab);
  });
  window.scrollTo(0, 0);
}

// ---------- PWA / offline ----------
// ১) ম্যানিফেস্টে পূর্ণ (absolute) start_url বসায়, যাতে ইনস্টল করলে ঠিক এই পেজই খোলে
(function () {
  try {
    const base = location.href.split('#')[0].split('?')[0];
    const icon = document.querySelector('link[rel="icon"]').href;
    const m = {
      name: 'GMV Save - Media Downloader', short_name: 'GMV Save',
      start_url: base, scope: base.replace(/[^\/]*$/, ''),
      display: 'standalone', orientation: 'portrait',
      background_color: '#ffffff', theme_color: '#4f46e5',
      icons: [{ src: icon, sizes: 'any', type: 'image/svg+xml', purpose: 'any maskable' }]
    };
    if (location.protocol.startsWith('http')) {
      document.querySelector('link[rel="manifest"]').href =
        URL.createObjectURL(new Blob([JSON.stringify(m)], { type: 'application/manifest+json' }));
    }
  } catch (e) {}
})();

// ২) অফলাইন ক্যাশ: ব্রাউজার Blob/data URL থেকে সার্ভিস ওয়ার্কার চালাতে দেয় না।
//    তাই হোস্টিংয়ে sw.js থাকলে (একই ফোল্ডারে) তবেই রেজিস্টার হবে; না থাকলে কিছুই নষ্ট হবে না।
if ('serviceWorker' in navigator && location.protocol.startsWith('http')) {
  window.addEventListener('load', async () => {
    try {
      const r = await fetch('sw.js', { method: 'HEAD', cache: 'no-store' });
      if (r.ok && (r.headers.get('content-type') || '').includes('javascript')) {
        navigator.serviceWorker.register('sw.js');
      }
    } catch (e) {}
  });
}
