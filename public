  .ic-youtube  { color: #FF0000; }
  .ic-tiktok { color: #000000; text-shadow: -1.5px -1px 0 #25F4EE, 1.5px 1px 0 #FE2C55; }
  .ic-instagram {
    background: radial-gradient(circle at 30% 107%, #fdf497 0%, #fdf497 5%, #fd5949 45%, #d6249f 60%, #285AEB 90%);
